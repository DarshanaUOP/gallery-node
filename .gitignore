# Luminary — .gitignore

# All runtime data files (auto-generated on first run)
data/

# Daily log files
logs/*.log

# Thumbnail cache — directory tracked, contents ignored
thumb/*
!thumb/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.env

# OS
.DS_Store
Thumbs.db

# Python venv
venv/
venv*/

# Build related files and directories
dist/
build/
*.spec