# Luminary — .gitignore

# All runtime data files (auto-generated on first run)
app/src/backend/data

app/src/backend/data

# Daily log files
# app/src/backend/logs
# app/src/backend/logs/*

# Thumbnail cache — directory tracked, contents ignored
app/src/backend/thumb/*
!thumb/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.env

# OS
.DS_Store
Thumbs.db

# Python venv
venv/
venv*/

# Build related files and directories
dist/
build/
*.spec