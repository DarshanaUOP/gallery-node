# Luminary — .gitignore

# All runtime data files (auto-generated on first run)
app/src/resources/data/
!app/src/resources/data/.gitkeep

# Daily log files
app/src/resources/temp/logs/*

# Thumbnail cache — directory tracked, contents ignored
app/src/resources/temp/thumb/*
!thumb/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.env

# OS
.DS_Store
Thumbs.db

# Python venv
venv/
venv*/

# Build related files and directories
dist/
build/
*.spec